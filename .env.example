# Copy to .env and edit. Never commit .env.
APP_PORT=8080

# Public address of the site (no trailing slash). Used for Google Sign-In redirects.
# e.g. PUBLIC_URL=https://members.aisarc.org
PUBLIC_URL=

# First admin account (created on first start only; change password afterwards in the app).
ADMIN_USERNAME=admin
ADMIN_PASSWORD=change-me-now

# Random long string used to sign login sessions (e.g. `openssl rand -hex 32`).
SESSION_SECRET=

# Set to true when served over HTTPS.
COOKIE_SECURE=false

# ---------------- Google Sign-In ----------------
# Create an "OAuth client ID" (type: Web application) at
# https://console.cloud.google.com/apis/credentials and fill in:
#   Authorized JavaScript origins:  https://members.aisarc.org
#   Authorized redirect URIs:       https://members.aisarc.org/auth/google/callback
# (for local testing you can also add http://localhost:8080 and
#  http://localhost:8080/auth/google/callback)
# e.g. GOOGLE_CLIENT_ID=1234567890-abcdefghijklmnop.apps.googleusercontent.com
GOOGLE_CLIENT_ID=
# Must exactly match one of the "Authorized redirect URIs" above.
# Defaults to ${PUBLIC_URL}/auth/google/callback; leave empty to use the popup sign-in instead.
# e.g. GOOGLE_REDIRECT_URI=https://members.aisarc.org/auth/google/callback
GOOGLE_REDIRECT_URI=
# Comma-separated Google accounts that get admin access when signing in with Google.
ADMIN_EMAILS=

# ---------------- Auto-update (updater service) ----------------
# Branch to follow and polling interval (seconds).
GIT_BRANCH=main
POLL_INTERVAL=60
# Private repository over HTTPS: username + read-only access token.
#   GitHub: Settings > Developer settings > Fine-grained token, repo "Contents: Read-only"
#   GitLab: Project > Settings > Access tokens (read_repository) or a Deploy token
# GIT_REPO_URL is optional; set it if the server checkout was cloned with a different URL.
# e.g. GIT_REPO_URL=https://github.com/your-org/aisarc.git
#      GIT_USERNAME=your-github-username
#      GIT_TOKEN=github_pat_11ABCDEFG...
GIT_REPO_URL=
GIT_USERNAME=
GIT_TOKEN=
# Alternative for SSH remotes (git@github.com:...): folder with a deploy key + known_hosts.
# SSH_KEY_DIR=/home/deploy/.ssh

# Optional HTTPS with Caddy (docker compose --profile https up -d)
# DOMAIN=members.aisarc.org