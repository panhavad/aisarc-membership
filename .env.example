# Copy to .env and edit. Never commit .env.
APP_PORT=8080

# First admin account (created on first start only; change password afterwards in the app).
ADMIN_USERNAME=admin
ADMIN_PASSWORD=change-me-now

# Random long string used to sign login sessions (e.g. `openssl rand -hex 32`).
SESSION_SECRET=

# Set to true when served over HTTPS.
COOKIE_SECURE=false

# Google Sign-In: OAuth 2.0 Web client ID from https://console.cloud.google.com/apis/credentials
# Add your site URL (e.g. https://members.aisarc.org) to "Authorized JavaScript origins".
GOOGLE_CLIENT_ID=
# Comma-separated Google accounts that get admin access when signing in with Google.
ADMIN_EMAILS=

# Auto-update: branch to follow and polling interval (seconds).
GIT_BRANCH=main
POLL_INTERVAL=60
# Folder with an SSH deploy key if the repo remote uses SSH (git@github.com:...).
# SSH_KEY_DIR=/home/deploy/.ssh

# Optional HTTPS with Caddy (docker compose --profile https up -d)
# DOMAIN=members.aisarc.org
